# Nginx reverse proxy for backend.cobrother.com → Uvicorn (127.0.0.1:8000)
#
# Install on Lightsail:
#   sudo cp deploy/nginx-backend.conf.example /etc/nginx/sites-available/backend.cobrother.com
#   sudo ln -sf /etc/nginx/sites-available/backend.cobrother.com /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Cloudflare: enable Network → WebSockets for this zone.
#
# Also set DATABASE_URL to Supabase port :6543 (transaction pooler) in server .env — see .env.example.

upstream cobrother_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name backend.cobrother.com;

    client_max_body_size 25m;

    location / {
        proxy_pass http://cobrother_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
    }

    # WebSocket upgrades (notifications, auction SockJS/STOMP)
    location /ws/ {
        proxy_pass http://cobrother_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
