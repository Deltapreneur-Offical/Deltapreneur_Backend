# EC2 production — split architecture (cobrother.com SPA + backend.cobrother.com API).
# Copy to /opt/cobrother/backend/.env and fill secrets. Do not commit real passwords.

ENVIRONMENT=production

# --- Database (RDS — only reachable from EC2 VPC) ---
DATABASE_URL=postgresql://cobrotherpython:<PASSWORD>@database-1.cno8smi8qae3.ap-south-1.rds.amazonaws.com:5432/postgres

# --- URLs (live CoBrother defaults — do not copy this file over production .env) ---
BACKEND_BASE_URL=https://backend.cobrother.com
FRONTEND_BASE_URL=https://cobrother.com
CORS_ALLOW_ORIGINS=https://cobrother.com,https://www.cobrother.com,https://hubregistrar.com,https://www.hubregistrar.com
AUTH_COOKIE_DOMAIN=.cobrother.com
# AUTH_COOKIE_SAMESITE stays lax (default). Host-based code sets .hubregistrar.com
# cookies only when the API Host is backend.hubregistrar.com.
TRUST_PROXY_HEADERS=True

# --- Google OAuth ---
# Live CoBrother callback — do not remove or replace this URI on production.
GOOGLE_OAUTH_REDIRECT_URI=https://backend.cobrother.com/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=https://cobrother.com/auth/callback
# Optional additive HubRegistrar callback. Unset until DNS + Google Console ADD.
# Never replace GOOGLE_OAUTH_REDIRECT_URI with this value.
# GOOGLE_OAUTH_REDIRECT_URI_HUBREGISTRAR=https://backend.hubregistrar.com/api/v1/auth/oauth/google/callback

# --- LinkedIn (add redirect in LinkedIn Developer Portal) ---
LINKEDIN_REDIRECT_URI=https://backend.cobrother.com/api/v1/community/linkedin/callback
# Optional additive HubRegistrar callback. Never replace LINKEDIN_REDIRECT_URI.
# LINKEDIN_REDIRECT_URI_HUBREGISTRAR=https://backend.hubregistrar.com/api/v1/community/linkedin/callback

# --- Storage ---
STORAGE_BACKEND=aws
AWS_BUCKET_NAME=cobrother-python
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- JWT ---
JWT_REFRESH_TOKEN_PEPPER_KID=v1

# --- Bot protection (Cloudflare Turnstile) ---
# Set via GitHub Actions secrets TURNSTILE_SITE_KEY + TURNSTILE_SECRET_KEY (patch_ec2_turnstile.sh)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: only when DOMAIN_REGISTRAR=openprovider
# OPENPROVIDER_WEBHOOK_SECRET=  # Header: X-OpenProvider-Webhook-Secret
