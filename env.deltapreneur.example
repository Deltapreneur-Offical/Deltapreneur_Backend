# Deltapreneur backend — copy to .env (never commit .env)
# Isolated from CoBrother / HubRegistrar / AWS RDS.

ENVIRONMENT=development

# --- Database: Deltapreneur Supabase ONLY ---
# Replace [YOUR-PASSWORD] with the database password from:
# Supabase → Project Settings → Database
# Do NOT use CoBrother RDS, 127.0.0.1:5433, or rds.amazonaws.com.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ohtboooxiqfrbumlidzz.supabase.co:5432/postgres
# Optional pooler (recommended later): port 6543 Session/Transaction mode URI from Supabase
DATABASE_URL_DIRECT=
TEST_DATABASE_URL=

# --- URLs (change when DNS is live) ---
BACKEND_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# AUTH_COOKIE_DOMAIN=.deltapreneur.com

# --- Auth / JWT (generate NEW secrets for Deltapreneur; do not reuse CoBrother JWT) ---
JWT_SECRET_KEY=change-me-use-openssl-rand-base64-48
JWT_ALGORITHM=HS512
JWT_ACCESS_TOKEN_EXPIRE_MS=3600000
JWT_REFRESH_TOKEN_EXPIRE_MS=2592000000
JWT_REFRESH_TOKEN_PEPPER=change-me-pepper-min-32-chars
JWT_REFRESH_TOKEN_PEPPER_KID=v1
AUTH_COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=False

# --- Google OAuth: SAME Google Cloud client as CoBrother/HubRegistrar ---
# Paste the existing Client ID + Secret into local .env only.
# In Google Cloud Console, ADD (do not remove) redirect URIs for Deltapreneur:
#   http://127.0.0.1:8000/api/v1/auth/oauth/google/callback
#   https://api.deltapreneur.com/api/v1/auth/oauth/google/callback  (when live)
# Keep existing cobrother.com / hubregistrar.com URIs so those sites keep working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://127.0.0.1:5173/auth/callback

# --- Storage: this project's Supabase (not AWS S3) ---
STORAGE_BACKEND=supabase
SUPABASE_URL=https://ohtboooxiqfrbumlidzz.supabase.co
SUPABASE_STORAGE_BUCKET=deltapreneur
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=ap-south-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Mail / payments / registrar: new or copied locally, never commit ---
MAIL_FROM=no-reply@deltapreneur.com
MAIL_FROM_NAME=Deltapreneur
RAZORPAY_KEY_ID=
OPENPROVIDER_USERNAME=
