# Dummy values for GitHub Actions CI only — never use in production.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://ci:ci@localhost:5432/cobrother_ci_app
TEST_DATABASE_URL=postgresql+asyncpg://ci:ci@localhost:5432/cobrother_ci_test

JWT_SECRET_KEY=ci-only-not-for-production-use-32chars-min!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MS=3600000
JWT_REFRESH_TOKEN_EXPIRE_MS=86400000
JWT_REFRESH_TOKEN_PEPPER=ci-pepper-not-for-production-use!!
JWT_REFRESH_TOKEN_PEPPER_KID=ci

MAIL_USERNAME=ci@example.com
MAIL_PASSWORD=ci-mail-password
MAIL_FROM=ci@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_FROM_NAME=CoBrother CI
MAIL_REPLY_TO=support@cobrother.com

BACKEND_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:5173

RAZORPAY_KEY_ID=rzp_test_ci
RAZORPAY_KEY_SECRET=ci_razorpay_secret
REQUIRE_DOMAIN_VERIFICATION_BEFORE_PURCHASE=false
REQUIRE_TECHNOLOGY_VERIFICATION_BEFORE_PURCHASE=false
# Frontend CI/build should set matching VITE_REQUIRE_* flags (see CoBrother_Frontend/.env.example)
