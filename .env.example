# =============================================================================
# CoBrother Backend — environment template (PLACEHOLDERS ONLY)
# Copy to .env and fill real values. Never commit .env or real secrets.
# Local dev: ENVIRONMENT=development
# EC2 production: see env.ec2.production.example
# =============================================================================

ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/cobrother
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cobrother_test
# Optional direct RDS when local SSH tunnel (127.0.0.1:5433) is down:
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@YOUR_RDS_HOST:5432/postgres
# Connection reliability (do not raise pool size on small Render instances):
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE_SECONDS=90
# Connect timeout: 15s absorbs a bursty homepage on the Supabase pooler.
# DB_CONNECT_TIMEOUT_SECONDS=15
# DB_POOL_TIMEOUT_SECONDS=10
# DB_COMMAND_TIMEOUT_SECONDS=30
# Reuse a bounded pool on the Supabase transaction pooler (:6543) instead of
# connecting per request. Set False to restore the old NullPool behaviour.
# DB_POOLER_REUSE_CONNECTIONS=True

# --- URLs ---
BACKEND_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# AUTH_COOKIE_DOMAIN=.hubregistrar.com

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-use-openssl-rand-base64-48
JWT_ALGORITHM=HS512
JWT_ACCESS_TOKEN_EXPIRE_MS=3600000
JWT_REFRESH_TOKEN_EXPIRE_MS=2592000000
JWT_REFRESH_TOKEN_PEPPER=change-me-pepper-min-32-chars
JWT_REFRESH_TOKEN_PEPPER_KID=v1
AUTH_COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=False

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://127.0.0.1:5173/auth/callback
# Optional additive HubRegistrar Google callback (production only; leave unset locally)
# GOOGLE_OAUTH_REDIRECT_URI_HUBREGISTRAR=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/api/v1/community/linkedin/callback
# Optional additive HubRegistrar LinkedIn callback (production only; leave unset locally)
# Never replace LINKEDIN_REDIRECT_URI.
# LINKEDIN_REDIRECT_URI_HUBREGISTRAR=

# --- Facebook / Instagram (optional) ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=

# --- Mail ---
# Replace the example.com values below. Any *.example.com host is treated as
# unconfigured (RFC 2606 reserves it, so it never resolves) and outbound email
# is disabled rather than failing per-request with a DNS error.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_REPLY_TO=support@example.com
# Domain registration emails — authenticate as domains@ mailbox (Google App Password)
# MAIL_DOMAINS_FROM=domains@hubregistrar.com
# MAIL_DOMAINS_USERNAME=domains@hubregistrar.com
# MAIL_DOMAINS_PASSWORD=
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_FROM_NAME=HubRegistrar
# SMTP connect/read timeout (seconds). If a PaaS blocks outbound SMTP, keep this
# low so a send fails fast instead of hanging ~60s (fastapi-mail's default).
# Feedback sends in the background, so this never blocks the visitor's request.
MAIL_TIMEOUT_SECONDS=20
# If port 587 (STARTTLS) is blocked by the host, try implicit TLS on 465 instead:
#   MAIL_PORT=465
#   MAIL_SSL_TLS=True
#   MAIL_STARTTLS=False

# --- Storage ---
STORAGE_BACKEND=local
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# --- Razorpay (use rzp_test_* for local; never put live secrets in git) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SANDBOX_KEY_ID=
RAZORPAY_SANDBOX_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# --- Domain GST ---
DOMAIN_GST_ENABLED=true
DOMAIN_GST_RATE=18
DOMAIN_PRICE_GST_INCLUSIVE=false
# Display catalog cache only. 0 disables. Checkout still uses live quotes.
STOREFRONT_PRICES_CACHE_TTL_SECONDS=180
COBROTHER_GSTIN=
COBROTHER_BILLING_LEGAL_NAME=CoBrother Pvt. Ltd.

# --- OpenProvider ---
OPENPROVIDER_USE_SANDBOX=false
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
OPENPROVIDER_API_BASE_URL=https://api.openprovider.eu
OPENPROVIDER_CLIENT_IP=
OPENPROVIDER_PANEL_INR_FACTOR=1.0
DOMAIN_STOREFRONT_DEMO_FALLBACK=false
OPENPROVIDER_DEFAULT_NAMESERVERS=ns1.hubregistrar.com,ns2.hubregistrar.com,ns3.hubregistrar.com

# --- ResellPortal Integration ---
RESELLPORTAL_BASE_URL=https://panel.resellportal.com/wp-json/resellportal/v1
RESELLPORTAL_API_KEY=
RESELLPORTAL_API_SECRET=
RESELLPORTAL_TEST_MODE=true
RESELLPORTAL_ALLOW_LIVE=false

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4.1-mini
AI_DOMAIN_MAX_TOKENS=1500
AI_TIMEOUT_SECONDS=30
AI_REQUEST_TIMEOUT_SECONDS=45
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://hubregistrar.com
OPENROUTER_APP_NAME=HubRegistrar

# --- Bot protection (Cloudflare Turnstile) ---
# Local: leave SECRET empty. Vite shows Cloudflare's always-pass dummy widget.
# Production (Render): set SITE_KEY + SECRET_KEY from the Cloudflare widget.
# Never commit SECRET_KEY. Site key is public.
# TURNSTILE_SITE_KEY=0x4AAAAAAErAJk9ECeMGvhli
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Production allowlist only — do not include localhost or 127.0.0.1
# TURNSTILE_HOSTNAMES=www.deltapreneur.com,deltapreneur.com
TURNSTILE_HOSTNAMES=

# --- GSTIN verification ---
GSTIN_API_KEY=
GSTIN_API_SANDBOX=true
DOMAIN_VERIFICATION_DISABLE_WHOIS_EMAIL=false

# --- Domain marketplace transfer & escrow ---
AUTH_CODE_ENCRYPTION_KEY=
DOMAIN_TRANSFER_SELLER_DEADLINE_HOURS=36
DOMAIN_TRANSFER_BUYER_DEADLINE_DAYS=7
DOMAIN_TRANSFER_WHOIS_POLL_HOURS=6
DOMAIN_TRANSFER_OPS_BATCH_LIMIT=50
ADMIN_TRANSFER_ALERT_EMAIL=
REDIS_URL=
